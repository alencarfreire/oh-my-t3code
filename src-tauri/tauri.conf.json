{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oh My T3Code",
  "version": "0.1.0",
  "identifier": "com.vtech.ohmyt3code",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "Oh My T3Code",
        "width": 380,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "url": "index.html?view=popover"
      },
      {
        "label": "studio",
        "title": "Oh My T3Code — Preset Studio",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "url": "index.html?view=studio"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
